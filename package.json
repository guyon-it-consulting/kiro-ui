{
  "name": "kiro-ui",
  "version": "1.3.2",
  "description": "Desktop chat interface for Kiro CLI, connected via the Agent Client Protocol",
  "author": "Guyon IT Consulting <jerome.guyon@gmail.com>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"tsx --watch server.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && tsx server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src/ server.ts",
    "typecheck": "tsc --noEmit",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && node scripts/compile-server.js && electron-builder",
    "electron:build:mac": "npm run build && node scripts/compile-server.js && electron-builder --mac",
    "electron:build:linux": "npm run build && node scripts/compile-server.js && electron-builder --linux",
    "electron:build:win": "npm run build && node scripts/compile-server.js && electron-builder --win"
  },
  "build": {
    "appId": "dev.kiro.ui",
    "productName": "Kiro UI",
    "copyright": "Copyright © 2025 Guyon IT Consulting",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "server.js",
        "to": "server.js"
      },
      {
        "from": "server.package.json",
        "to": "package.json"
      },
      {
        "from": "dist/client",
        "to": "dist/client"
      }
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "darkModeSupport": true
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "guyon-it-consulting",
      "repo": "kiro-ui"
    }
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.22.1",
    "@aws-sdk/client-bedrock": "^3.1069.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1068.0",
    "@aws-sdk/client-sts": "^3.1069.0",
    "@aws-sdk/credential-providers": "^3.1069.0",
    "dompurify": "^3.4.5",
    "electron-updater": "^6.6.2",
    "express": "^4.22.2",
    "highlight.js": "^11.11.1",
    "marked": "15.0.12",
    "react": "^19.1.0",
    "react-diff-viewer-continued": "^4.2.2",
    "react-dom": "^19.1.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.2",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.5.1",
    "@vitest/coverage-v8": "^4.1.6",
    "concurrently": "^9.2.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.3.5",
    "vitest": "^4.1.6"
  }
}
